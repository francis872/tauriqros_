# ─── Spotify Web API ─────────────────────────────────────────────────────────
# Get at: https://developer.spotify.com/dashboard → Create app
# Gives: real music search + 30-second MP3 previews
VITE_SPOTIFY_CLIENT_ID=your_client_id_here
VITE_SPOTIFY_CLIENT_SECRET=your_client_secret_here

# ─── YouTube Data API v3 ─────────────────────────────────────────────────────
# Get at: https://console.developers.google.com → Enable "YouTube Data API v3"
# Gives: search any mainstream song + full playback via YouTube IFrame
VITE_YOUTUBE_API_KEY=your_youtube_api_key_here

# ─── Jamendo (optional override) ─────────────────────────────────────────────
# Register free at: https://devportal.jamendo.com
# Without this, uses the public demo key (works but rate-limited)
# Gives: 600K+ CC/indie tracks with full MP3 streams — NO SETUP REQUIRED
# VITE_JAMENDO_CLIENT_ID=your_client_id_here
